# MySQL connection string (TiDB Cloud, Aiven, PlanetScale, or your own MySQL 8 server)
# TiDB Cloud needs TLS:  mysql://USER:PASSWORD@HOST:4000/launchwright?sslaccept=strict
DATABASE_URL="mysql://user:password@localhost:3306/launchwright"

# The single admin account
ADMIN_EMAIL="you@example.com"
# Generate with:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=""

# Any random string of 32+ characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=""
