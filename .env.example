# MySQL connection string (TiDB Cloud, Aiven, PlanetScale, or your own MySQL 8 server)
# TiDB Cloud needs TLS:  mysql://USER:PASSWORD@HOST:4000/cometfront?sslaccept=strict
DATABASE_URL="mysql://user:password@localhost:3306/cometfront"

# The single admin account
ADMIN_EMAIL="you@example.com"
# Either set ADMIN_PASSWORD (10+ characters, kept secret in your host's settings)
# or, more secure, ADMIN_PASSWORD_HASH generated with: npm run hash-password -- "your-password"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""

# Any random string of 32+ characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=""
